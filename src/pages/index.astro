---
import {
  ArrowRight,
  ArrowUpRight,
  Menu,
  X,
  Code,
  Braces,
  GitBranch,
  Terminal,
  BookOpen,
  PawPrint,
} from '@lucide/astro';
import CodeWindow from '../components/CodeWindow.astro';
import Brand from '../components/Brand.astro';
import Tabs from '../components/Tabs.astro';
import Install from '../components/Install.astro';
import AgentShowcase from '../components/AgentShowcase.astro';
import JevShowcase from '../components/JevShowcase.astro';
import NotebookShowcase from '../components/NotebookShowcase.astro';
import Team from '../components/Team.astro';
import examples from '../data/examples.json';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

const docs = 'https://kedi-lang.org/docs/';
const github = 'https://github.com/kedi-lang/kedi';
const discord = 'https://discord.gg/cuSbZd5he';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f6f2" />
    <meta
      name="description"
      content="Compose model calls, decisions, and tools as typed programs. Natural language is part of the code, not a string on the side."
    />
    <meta
      property="og:title"
      content="Kedi - Program with natural language. Typed by design."
    />
    <meta
      property="og:description"
      content="Compose model calls, decisions, and tools as typed programs. Natural language is part of the code, not a string on the side."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://kedi-lang.org/" />
    <link rel="canonical" href="https://kedi-lang.org/" />
    <title>Kedi - Program with natural language. Typed by design.</title>
    <link rel="icon" href="/assets/kedi-favicon.webp" type="image/webp" />
    <link rel="preload" as="image" href="/assets/istanbul.webp" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="header-inner">
        <Brand showName={false} />
        <span class="brand-note">
          A PROGRAMMING LANGUAGE
          <br />
          OPEN SOURCE
        </span>
        <button
          class="menu-toggle icon-button"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Open navigation"
        >
          <Menu class="menu-open-icon" />
          <X class="menu-close-icon" />
        </button>
        <nav id="site-nav" aria-label="Main navigation">
          <a href={docs}>Documentation</a>
          <a href="#language">The language</a>
          <a href="#jev">Kedi + Jev</a>
          <a href={discord}>
            Discord <ArrowUpRight size={14} />
          </a>
          <a href={github}>
            GitHub <ArrowUpRight size={14} />
          </a>
          <a href="#start" class="button button-primary">
            Get started <ArrowRight size={17} />
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <img
          class="hero-landscape"
          src="/assets/istanbul.webp"
          width="1660"
          height="948"
          alt=""
          fetchpriority="high"
        />
        <div class="hero-content">
          <span class="eyebrow hero-eyebrow">A PROGRAMMING LANGUAGE</span>
          <h1 id="hero-title">Kedi</h1>
          <p class="hero-statement">
            Program with natural language.
            <br />
            Typed by design.
          </p>
          <p class="hero-description">
            Compose model calls, decisions, and tools as typed programs. Natural
            language is part of the code, not a string on the side.
          </p>
          <div class="hero-demo">
            <CodeWindow example={examples.hello} id="hero" replay />
            <button
              class="cat-button"
              type="button"
              aria-label="Say hello to the Istanbul cat"
              data-tooltip="Meow!"
            >
              <img
                src="/assets/cat.webp"
                width="160"
                height="194"
                alt="A tuxedo Istanbul cat with a yellow collar"
              />
            </button>
          </div>
          <Install />
        </div>
        <span class="location-note">41.0082° N / 28.9784° E</span>
      </section>

      <section
        id="language"
        class="section language-section"
        aria-labelledby="language-title"
      >
        <div class="container">
          <div class="section-kicker">
            <span>01 / THE LANGUAGE</span>
            <span class="side-note">LESS GLUE. MORE MEANING.</span>
          </div>
          <h2 id="language-title">
            From a sentence
            <br class="mobile-break" /> to a typed value.
          </h2>
          <p class="section-intro">
            The context, the question, and the shape of the answer.
            <br class="desktop-break" /> All in the same line of your program.
          </p>
          <div class="sentence-example" aria-label="Kedi template anatomy">
            <code>
              <span class="syntax-keyword">&gt;&gt;</span> The next action in{' '}
              <mark class="input-mark">&lt;note&gt;</mark> is{' '}
              <mark class="output-mark">[action: Action]</mark>.
            </code>
          </div>
          <div class="anatomy-grid">
            <div>
              <span class="anatomy-number">01</span>
              <h3>Your context</h3>
              <p>
                <code>&lt;note&gt;</code> brings an existing value into the
                sentence.
              </p>
            </div>
            <div>
              <span class="anatomy-number">02</span>
              <h3>Your words</h3>
              <p>
                The natural-language template describes what you want to know.
              </p>
            </div>
            <div>
              <span class="anatomy-number">03</span>
              <h3>A real value</h3>
              <p>
                <code>[action: Action]</code> binds a record with an owner,
                task, and blocked state.
              </p>
            </div>
          </div>
          <div class="language-example">
            <div class="section-aside">
              <span class="tiny-label">SENTENCE IN. VALUE OUT.</span>
              <h3>
                Not a string
                <br />
                you have to untangle.
              </h3>
              <p>
                Use the result in the next statement, pass it to a procedure, or
                hand it to Python.
              </p>
              <a
                class="text-link"
                href={`${docs}core-language/templates-and-invokes/`}
              >
                Explore templates <ArrowRight size={17} />
              </a>
            </div>
            <CodeWindow example={examples.template} id="template" compact />
          </div>
        </div>
      </section>

      <section
        id="conditions"
        class="section conditions-section"
        aria-labelledby="conditions-title"
      >
        <div class="container">
          <div class="section-kicker">
            <span>02 / NATURAL CONTROL FLOW</span>
            <span class="side-note">WORDS CAN BE CONDITIONS, TOO.</span>
          </div>
          <div class="section-heading-row">
            <div>
              <h2 id="conditions-title">
                If it needs attention.
                <br />
                While it needs work.
              </h2>
            </div>
            <p>
              Let a model evaluate a claim.
              <br />
              Let your program decide what happens next.
            </p>
          </div>
          <Tabs
            id="flow"
            label="Control flow examples"
            tabs={[
              { id: 'if', label: 'Template if', icon: '?' },
              { id: 'loop', label: 'Template loop', icon: '↻' },
              { id: 'map', label: 'Loop + map' },
            ]}
          >
            <div
              id="flow-panel-if"
              role="tabpanel"
              aria-labelledby="flow-tab-if"
              class="example-layout"
              data-panel="if"
            >
              <CodeWindow example={examples.condition} id="if" />
              <div class="flow-aside">
                <span class="tiny-label">ONE CLAIM. TWO PATHS.</span>
                <p class="claim-text">
                  Does this API change
                  <br />
                  need a migration?
                </p>
                <div
                  class="branch-diagram"
                  aria-label="True selects migration; false keeps standard"
                >
                  <div class="branch active">
                    <span class="branch-state">True</span>
                    <ArrowRight size={17} />
                    <strong>migration</strong>
                  </div>
                  <div class="branch">
                    <span class="branch-state">False</span>
                    <ArrowRight size={17} />
                    <span>standard</span>
                  </div>
                </div>
                <p class="aside-caption">
                  Natural-language claims and deterministic Python conditions.
                  Same control flow.
                </p>
              </div>
            </div>
            <div
              id="flow-panel-loop"
              role="tabpanel"
              aria-labelledby="flow-tab-loop"
              class="example-layout"
              data-panel="loop"
              hidden
            >
              <CodeWindow example={examples.loop} id="loop" />
              <div class="flow-aside">
                <span class="tiny-label">CHECK. REVISE. CHECK AGAIN.</span>
                <ol class="loop-steps">
                  <li>
                    <span>01</span>
                    <div>
                      <strong>Check the promises</strong>
                      <p>Does the copy claim more than the facts support?</p>
                    </div>
                  </li>
                  <li>
                    <span>02</span>
                    <div>
                      <strong>Revise against the facts</strong>
                      <p>Remove unsupported formats and launch dates.</p>
                    </div>
                  </li>
                  <li>
                    <span>03</span>
                    <div>
                      <strong>Evaluate the new draft</strong>
                      <p>Stop when no unsupported promises are found.</p>
                    </div>
                  </li>
                </ol>
                <p class="aside-caption">
                  The condition is evaluated again before every iteration.
                </p>
              </div>
            </div>
            <div
              id="flow-panel-map"
              role="tabpanel"
              aria-labelledby="flow-tab-map"
              class="example-layout"
              data-panel="map"
              hidden
            >
              <CodeWindow example={examples.map} id="map" />
              <div class="flow-aside">
                <span class="tiny-label">ONE CONTINUATION PER ITEM.</span>
                <ol class="loop-steps">
                  <li>
                    <span>01</span>
                    <div>
                      <strong>Start with a collection</strong>
                      <p>Each incoming report gets its own iteration scope.</p>
                    </div>
                  </li>
                  <li>
                    <span>02</span>
                    <div>
                      <strong>Continue when its answer is ready</strong>
                      <p>
                        The map receives that report's classification and title.
                      </p>
                    </div>
                  </li>
                  <li>
                    <span>03</span>
                    <div>
                      <strong>Keep what qualifies</strong>
                      <p>Collect bug titles; leave feature requests out.</p>
                    </div>
                  </li>
                </ol>
                <p class="aside-caption">
                  Independent continuations can overlap. Kedi waits for the map
                  stage before moving on; completion order may differ.
                </p>
              </div>
            </div>
          </Tabs>
          <a class="text-link" href={`${docs}core-language/control-flow/`}>
            Read about conditions, loops, and maps <ArrowRight size={17} />
          </a>
        </div>
      </section>

      <section
        id="compose"
        class="section compose-section"
        aria-labelledby="compose-title"
      >
        <div class="container">
          <div class="section-kicker">
            <span>03 / A LANGUAGE, NOT AN ISLAND</span>
            <span class="side-note">KEEP YOUR PYTHON CLOSE.</span>
          </div>
          <h2 id="compose-title">Keep writing your program.</h2>
          <p class="section-intro">
            Templates are the beginning. Compose them with the tools you already
            use.
          </p>
          <Tabs
            id="compose"
            label="Composition examples"
            tabs={[
              { id: 'python', label: 'Python', icon: '`' },
              { id: 'procedure', label: 'Procedures', icon: '@' },
              { id: 'tool', label: 'Tools', icon: '>' },
            ]}
          >
            {(['python', 'procedure', 'tool'] as const).map((key, index) => (
              <div
                id={`compose-panel-${key}`}
                role="tabpanel"
                aria-labelledby={`compose-tab-${key}`}
                class="composition-panel"
                data-panel={key}
                hidden={index !== 0}
              >
                <CodeWindow example={examples[key]} id={key} />
                <div class="composition-note">
                  {key === 'python' ? (
                    <>
                      <Code size={25} />
                      <h3>
                        A backtick away
                        <br />
                        from Python.
                      </h3>
                      <p>
                        A model reads the pricing terms. Python multiplies the
                        typed numbers to get the annual total.
                      </p>
                    </>
                  ) : key === 'procedure' ? (
                    <>
                      <Braces size={25} />
                      <h3>
                        A workflow
                        <br />
                        you can call.
                      </h3>
                      <p>
                        Turn a report into a reusable, typed on-call handoff: a
                        problem and a concrete next step.
                      </p>
                    </>
                  ) : (
                    <>
                      <Terminal size={25} />
                      <h3>Tools, in context.</h3>
                      <p>
                        The model checks actual stock before answering. A Kedi
                        procedure reads the inventory through Python.
                      </p>
                      <a class="text-link" href="/examples/inventory.json">
                        Example inventory <ArrowRight size={15} />
                      </a>
                    </>
                  )}
                </div>
              </div>
            ))}
          </Tabs>
          <div class="capability-strip">
            <span>
              <Braces size={17} />
              Typed boundaries
            </span>
            <span>
              <GitBranch size={17} />
              Lexical scopes
            </span>
            <span>
              <Terminal size={17} />
              Python interop
            </span>
            <span>
              <Code size={17} />
              Pluggable model adapters
            </span>
          </div>
        </div>
      </section>

      <AgentShowcase docs={docs} />
      <JevShowcase />
      <NotebookShowcase />

      <section
        id="harness"
        class="section harness-section"
        aria-labelledby="harness-title"
      >
        <div class="container harness-layout">
          <div class="harness-copy">
            <span class="eyebrow coming-soon">COMING SOON</span>
            <h2 id="harness-title">Kedi Harness</h2>
            <p class="harness-statement">
              An agent harness.
              <br />
              With a mind of its own.
            </p>
            <p>
              Meet the cat taking the keyboard. An agent harness for your
              projects, with Kedi as its orchestration language. It can write
              and run Kedi programs to coordinate its own tools, subagents, and
              next steps.
            </p>
            <a class="text-link" href={github}>
              Follow the work on GitHub <ArrowUpRight size={17} />
            </a>
          </div>
          <figure class="harness-art">
            <img
              src="/assets/harness.webp"
              width="720"
              height="480"
              alt="The tuxedo cat at a retro computer, with a glass of Turkish tea beside the keyboard"
              loading="lazy"
            />
            <figcaption>
              LEARNING TO RUN THE SHOW. TEA BREAKS INCLUDED.
            </figcaption>
          </figure>
        </div>
      </section>

      <Team />

      <section
        id="start"
        class="section start-section"
        aria-labelledby="start-title"
      >
        <div class="container start-content">
          <span class="section-kicker">08 / YOUR FIRST .KEDI FILE</span>
          <h2 id="start-title">Write it. Run it. Ship it.</h2>
          <p>
            A little natural language. A little Python.
            <br />A program that's yours.
          </p>
          <Install full />
          <div class="start-links">
            <a
              class="button button-primary"
              href={`${docs}getting-started/first-program/`}
            >
              Write your first program <ArrowRight size={18} />
            </a>
            <a class="text-link" href={github}>
              Explore the source <ArrowUpRight size={16} />
            </a>
            <a class="text-link" href="#notebook">
              Try Kedi Notebook <ArrowRight size={16} />
            </a>
          </div>
        </div>
        <div class="ferry-scene">
          <div class="shore-label shore-left">KARAKÖY</div>
          <div class="shore-label shore-right">KADIKÖY</div>
          <div class="ferry-lane">
            <img
              class="ferry"
              src="/assets/ferry.webp"
              width="450"
              height="150"
              alt="An Istanbul ferry crossing the Bosphorus, with the cat on board"
              loading="lazy"
            />
          </div>
          <button
            class="icon-button motion-toggle"
            type="button"
            aria-pressed="false"
            aria-label="Pause"
            data-tooltip="Pause"
          >
            <PawPrint size={19} />
          </button>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <Brand />
        <p>
          Made with care. And a little curiosity.
          <br />
          <span>Your next idea, written in Kedi.</span>
        </p>
        <nav aria-label="Footer navigation">
          <a href="#team">The team</a>
          <a href={docs}>
            <BookOpen size={15} />
            Docs
          </a>
          <a href={github}>
            GitHub <ArrowUpRight size={14} />
          </a>
          <a href="https://www.linkedin.com/company/kedi-lang/">
            LinkedIn <ArrowUpRight size={14} />
          </a>
          <a href={discord}>
            Discord <ArrowUpRight size={14} />
          </a>
        </nav>
        <span class="footer-copyright">© 2026 Kedi contributors</span>
      </div>
    </footer>
    <div class="sr-only" role="status" id="copy-status"></div>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
