---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import CodeWindow from './CodeWindow.astro';
import examples from '../data/examples.json';

const guide = 'https://kedi-lang.org/docs/agent-adapters/typesafe/';
---

<section id="jev" class="section jev-section" aria-labelledby="jev-title">
  <div class="container">
    <div class="section-kicker">
      <span>05 / KEDI + JEV</span>
      <a class="jev-maker" href="https://typesafe.ai/">
        JEV BY TYPESAFE <ArrowUpRight size={13} />
      </a>
    </div>
    <h2 id="jev-title">
      Typed judgments.
      <br />
      Your next move.
    </h2>
    <p class="section-intro">
      Pick a queue. Assess cancellation intent. Let your program decide the
      priority.
    </p>
    <dl class="jev-primitives" aria-label="Jev primitives in Kedi">
      <div>
        <dt>Choice</dt>
        <dd>
          A <code>Literal</code> limits the answer to your defined options.
        </dd>
      </div>
      <div>
        <dt>Probability</dt>
        <dd>
          A value from 0 to 1. Keep the assessment; set your own decision rule.
        </dd>
      </div>
    </dl>
    <div class="showcase-layout">
      <CodeWindow example={examples.jev} id="jev" />
      <aside
        class="showcase-aside jev-aside"
        aria-label="Jev decisions in Kedi"
      >
        <div class="decision-rule">
          <span class="tiny-label">ONE REQUEST. TWO JUDGMENTS.</span>
          <p>
            <span>billing / priority</span>
          </p>
          <span class="decision-caption">
            Jev selects the queue and assesses cancellation intent. Python
            applies the 0.8 priority threshold without another model call.
          </span>
        </div>
        <p class="aside-caption">
          Illustrative values and threshold, not a calibrated policy or a
          correctness guarantee.
        </p>
      </aside>
    </div>
    <a class="text-link jev-guide" href={guide}>
      Explore the Jev integration <ArrowRight size={17} />
    </a>
  </div>
</section>
