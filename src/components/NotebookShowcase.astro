---
import { ArrowRight, Copy, Check, Expand } from '@lucide/astro';
import Tabs from './Tabs.astro';

const guide = 'https://docs.kedi-lang.org/tooling/notebook/';
---

<section
  id="notebook"
  class="section notebook-section"
  aria-labelledby="notebook-title"
>
  <div class="container">
    <div class="section-kicker">
      <span>06 / INTERACTIVE KEDI</span>
      <span class="side-note">A LITTLE ROOM TO EXPERIMENT.</span>
    </div>
    <h2 id="notebook-title">Your program, one step at a time.</h2>
    <Tabs
      id="interactive"
      label="Interactive environments"
      tabs={[
        { id: 'notebook', label: 'Notebook' },
        { id: 'repl', label: 'Terminal REPL' },
      ]}
    >
      <div
        id="interactive-panel-notebook"
        role="tabpanel"
        aria-labelledby="interactive-tab-notebook"
        data-panel="notebook"
        tabindex="0"
      >
        <div class="notebook-intro">
          <div>
            <h3 class="interactive-heading">One cell leads to another.</h3>
            <p class="section-intro">
              Try a template. Inspect its values. Keep going in the next cell,
              with your program's state right where you left it.
            </p>
          </div>
          <div class="notebook-launch interactive-launch">
            <div class="install-command">
              <span class="shell-prefix" aria-hidden="true">
                $
              </span>
              <code>kedi notebook</code>
              <button
                type="button"
                class="icon-button"
                data-copy-command
                aria-label="Copy notebook command"
                data-tooltip="Copy command"
              >
                <Copy size={17} class="copy-icon" />
                <Check size={17} class="copied-icon" />
              </button>
            </div>
            <p class="notebook-launch-note">
              Opens your browser at <code>localhost:8788/notebook/</code>.
              Served locally, on your machine.
            </p>
            <details class="notebook-setup">
              <summary>First-time setup</summary>
              <p>
                From a Kedi source checkout with its submodules initialized,
                install the notebook dependencies and launch it with:
              </p>
              <div class="install-command">
                <code>uv run --extra notebook kedi notebook</code>
                <button
                  type="button"
                  class="icon-button"
                  data-copy-command
                  aria-label="Copy notebook setup command"
                  data-tooltip="Copy command"
                >
                  <Copy size={17} class="copy-icon" />
                  <Check size={17} class="copied-icon" />
                </button>
              </div>
              <p>
                After installation, run <code>kedi notebook</code> with that
                environment active.
              </p>
            </details>
          </div>
        </div>
        <figure class="notebook-preview">
          <a
            href="/assets/kedi-notebook-current.webp"
            target="_blank"
            rel="noopener"
            aria-label="View full-size Kedi Notebook screenshot"
          >
            <img
              src="/assets/kedi-notebook-current.webp"
              width="2400"
              height="1160"
              alt="The current dark Kedi Notebook: one cell captures Istanbul and the Bosphorus; the next displays a sentence using both values."
              loading="lazy"
              decoding="async"
            />
            <span class="notebook-expand">
              <Expand size={16} /> View full size
            </span>
          </a>
          <figcaption>
            <span>
              <strong>[1]</strong> A template captures <code>city</code> and{' '}
              <code>strait</code>.
            </span>
            <span>
              <strong>[2]</strong> <code>&gt; show:</code> uses both values in
              the next cell.
            </span>
          </figcaption>
        </figure>
        <div class="notebook-details">
          <div>
            <h3>Your Python, your choice.</h3>
            <p>
              Start with browser Python, or select a host interpreter with a
              reusable notebook virtual environment.
            </p>
          </div>
          <div>
            <h3>More than a scratchpad.</h3>
            <p>
              Mix Kedi, Markdown, and terminal cells. Save a{' '}
              <code>.kedinb</code> notebook, with optional execution progress
              and no Secret Manager values.
            </p>
          </div>
          <a class="text-link" href={guide}>
            Notebook setup guide <ArrowRight size={17} />
          </a>
        </div>
      </div>
      <div
        id="interactive-panel-repl"
        role="tabpanel"
        aria-labelledby="interactive-tab-repl"
        data-panel="repl"
        tabindex="0"
        hidden
      >
        <div class="notebook-intro">
          <div>
            <h3 class="interactive-heading">Stay in the terminal.</h3>
            <p class="section-intro">
              Write a template, inspect a capture, and build on it. Variables,
              procedures, and model settings stay with your session.
            </p>
          </div>
          <div class="repl-launch interactive-launch">
            <div class="install-command">
              <span class="shell-prefix" aria-hidden="true">
                $
              </span>
              <code>kedi --idle</code>
              <button
                type="button"
                class="icon-button"
                data-copy-command
                aria-label="Copy REPL command"
                data-tooltip="Copy command"
              >
                <Copy size={17} class="copy-icon" />
                <Check size={17} class="copied-icon" />
              </button>
            </div>
            <p class="notebook-launch-note">
              Syntax highlighting is on by default. Use <code>--no-color</code>{' '}
              for plain text.
            </p>
          </div>
        </div>
        <figure class="notebook-preview repl-preview">
          <a
            href="/assets/kedi-repl.webp"
            target="_blank"
            rel="noopener"
            aria-label="View full-size Kedi REPL screenshot"
          >
            <img
              src="/assets/kedi-repl.webp"
              width="1981"
              height="794"
              alt="A highlighted Kedi 0.2.0 terminal session captures Istanbul, then displays Cats love Istanbul."
              loading="lazy"
              decoding="async"
            />
            <span class="notebook-expand">
              <Expand size={16} /> View full size
            </span>
          </a>
          <figcaption>
            A typed capture becomes a value you can use on the next line.
          </figcaption>
        </figure>
        <div class="notebook-details">
          <div>
            <h3>Start small. Keep going.</h3>
            <p>
              Use <code>:multiline</code> for a longer fragment and{' '}
              <code>:show</code> to inspect a value.
            </p>
          </div>
          <div>
            <h3>Take it with you.</h3>
            <p>
              Save your session's source to a <code>.kedi</code> file with{' '}
              <code>:dump</code>.
            </p>
          </div>
          <a class="text-link" href="https://docs.kedi-lang.org/tooling/repl/">
            Explore the REPL <ArrowRight size={17} />
          </a>
        </div>
      </div>
    </Tabs>
  </div>
</section>
