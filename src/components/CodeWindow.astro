---
import { Copy, Check, FileCode, RotateCcw, Undo2 } from '@lucide/astro';
import { highlight } from '../lib/highlight';

interface Props {
  example: {
    filename: string;
    code: string;
    values: { name: string; type: string; value: string }[];
  };
  id: string;
  replay?: boolean;
  compact?: boolean;
  showValues?: boolean;
}
const {
  example,
  id,
  replay = false,
  compact = false,
  showValues = true,
} = Astro.props;
---

<div
  class:list={['code-window', { compact, 'source-only': !showValues }]}
  data-demo={id}
>
  <div
    class="window-title"
    role="group"
    aria-label={`${example.filename} window position`}
    tabindex="-1"
  >
    <span class="filename">
      <FileCode size={17} aria-hidden="true" />
      {example.filename}
    </span>
    <div class="window-controls">
      <button
        class="icon-button"
        type="button"
        data-reset-window
        aria-label={`Reset ${example.filename} window position`}
        data-tooltip="Reset position"
        hidden
        disabled
      >
        <Undo2 size={16} aria-hidden="true" />
      </button>
      <button
        class="icon-button"
        type="button"
        data-copy-code
        aria-label={`Copy ${example.filename}`}
        data-tooltip="Copy code"
      >
        <Copy size={16} class="copy-icon" />
        <Check size={16} class="copied-icon" />
      </button>
    </div>
  </div>
  <div
    class="code-body"
    tabindex="0"
    role="region"
    aria-label={`${example.filename} source code`}
  >
    <pre><code>{example.code.split('\n').map((line, index) => <span class="code-line" data-line={index + 1} data-replay-phase={line.trim().startsWith('>>') ? 'template' : line.trim().startsWith('> use:') ? 'context' : undefined}><span class="line-number" aria-hidden="true">{index + 1}</span><span class="line-source">{highlight(line).map(token => <span class={token.kind ? `syntax-${token.kind}` : undefined}>{token.text}</span>)}{!line && '\u00a0'}</span></span>)}</code></pre>
  </div>
  <textarea
    class="copy-source"
    hidden
    aria-hidden="true"
  >{example.code}</textarea>
  {showValues && (
    <>
      <div class="result-header">
        <span>BOUND VALUES</span>
        <span class="example-label">Illustrative output</span>
      </div>
      <div class="result-body" aria-live="polite" aria-atomic="true">
        <dl class="value-list">
          {example.values.map((value) => (
            <div class="value-row">
              <dt>{value.name}</dt>
              <dd class="value-type">{value.type}</dd>
              <dd class="value-result">{value.value}</dd>
            </div>
          ))}
        </dl>
        {replay && (
          <button
            type="button"
            class="replay-button"
            data-replay
            aria-label={`Replay ${example.filename} example`}
          >
            <RotateCcw size={16} />
            <span>Replay example</span>
          </button>
        )}
      </div>
    </>
  )}
</div>
